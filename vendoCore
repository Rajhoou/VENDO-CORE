        "class VendingMachine:\n",
        "    def __init__(self, inventory: Inventory, payment_method: PaymentMethod, logger: TransactionLogger):\n",
        "        self.inventory = inventory\n",
        "        self.payment_method = payment_method\n",
        "        self.logger = logger\n",
        "        self.balance = 0\n",
        "        self.state = VendingState.IDLE\n",
        "\n",
        "    def insert_money(self, amount: int):\n",
        "        collected = self.payment_method.collect(amount)\n",
        "        self.balance += collected\n",
        "        self.state = VendingState.HAS_MONEY\n",
        "        print(f\"Balance: {self.balance}\")\n",
        "\n",
        "    def select_product(self, product_name: str):\n",
        "        product = self.inventory.get_product(product_name)\n",
        "\n",
        "        if not product:\n",
        "            print(\"Invalid selection\")\n",
        "            return\n",
        "\n",
        "        if not product.is_available():\n",
        "            self.state = VendingState.OUT_OF_STOCK\n",
        "            print(\"Out of stock\")\n",
        "            return\n",
        "        if self.balance < product.price:\n",
        "            print(f\"Insufficient balance. Need {product.price - self.balance} more\")\n",
        "            return\n",
        "\n",
        "        self._dispense(product)\n",
        "\n",
        "    def _dispense(self, product: Product):\n",
        "        self.state = VendingState.DISPENSING\n",
        "        product.reduce_stock()\n",
        "        change = self.balance - product.price\n",
        "        self.balance = 0\n",
        "\n",
        "        print(f\"Dispensing {product.name}\")\n",
        "        if change > 0:\n",
        "            print(f\"Returning change: {change}\")\n",
        "\n",
        "        self.logger.log(f\"{product.name} sold for {product.price}\")\n",
        "        self.state = VendingState.IDLE"
      ],
