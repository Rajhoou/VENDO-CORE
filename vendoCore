        "from abc import ABC, abstractmethod\n",
        "\n",
        "class PaymentMethod(ABC):\n",
        "    @abstractmethod\n",
        "    def collect(self, amount: int) -> int:\n",
        "       \"\"\"Returns the amount sucessfully collected.\"\"\"\n",
        "       pass\n",
        "\n",
        "class CoinPayment(PaymentMethod):\n",
        "    def collect(self, amount: int) -> int:\n",
        "        return amount\n",
        "\n",
        "class CardPayment(PaymentMethod):\n",
        "    def collect(self, amount: int) -> int:\n",
        "        print(f\"Charging card ${amount / 100:.2f}\")\n",
        "        return amount"
      ],
