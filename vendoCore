        "class Product:\n",
        "    def __init__(self, name: str, price: int, quantity: int):\n",
        "        self.name = name\n",
        "        self.price = price\n",
        "        self.quantity = quantity\n",
        "\n",
        "    def is_available(self) -> bool:\n",
        "        return self.quantity > 0\n",
        "\n",
        "    def reduce_stock(self):\n",
        "         self.quantity -= 1\n",
